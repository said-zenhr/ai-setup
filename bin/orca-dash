def warmth(t):
    """0 for red, rising through orange, yellow, green and blue to purple; grey and uncolored tabs sort last."""
    if not t.get("color"):
        return 3
    r, g, b = (int(t["color"][i:i + 2], 16) / 255 for i in (1, 3, 5))
    hue, _, saturation = colorsys.rgb_to_hls(r, g, b)
    if saturation < 0.2:
        return 2
    return hue - 1 if hue > 0.85 else hue


SORTS = {
    "state": lambda t: (STATE_ORDER[t["state"]], -(t.get("lastOutputAt") or 0)),
    "recent": lambda t: -(t.get("lastOutputAt") or 0),
    "oldest": lambda t: t.get("lastOutputAt") or 0,
    "name": lambda t: t["name"].lower(),
    "hot→cool": lambda t: (warmth(t), t["name"].lower()),
    "cool→hot": lambda t: (-warmth(t) if warmth(t) < 2 else warmth(t), t["name"].lower()),
}


def orca(*args):
    out = subprocess.run(["orca", *args, "--json"], capture_output=True, text=True, timeout=15)
    try:
        return json.loads(out.stdout)
    except ValueError:
        return {}


def read_screen(handle):
    return "\n".join(orca("terminal", "read", "--terminal", handle, "--screen").get("result", {}).get("terminal", {}).get("tail", []))


def terminal_of(pid):
    env = subprocess.run(["ps", "eww", "-o", "command=", "-p", str(pid)], capture_output=True, text=True).stdout
    match = re.search(r"ORCA_TERMINAL_HANDLE=(term_[\w-]+)", env)
    return match.group(1) if match else None


def screen_state(screen):
    bottom = "\n".join(screen.splitlines()[-15:])
    if NEEDS_YOU.search(bottom):
        return "need"
    if WORKING.search(bottom):
        return "work"
    return "idle"


HATS = ["         ", "   ▗▄▖   ", "    ╻    ", "   ▄█▄   ", "  ♛      ", "    ✿    ", "  ▁▃▅▃▁  ", "   ◢◣    ",
        "  ╲   ╱  ", "    ◆    "]
EYES = [("▛", "▜"), ("▌", "▐"), ("▙", "▟"), ("▘", "▝")]
LEGS = ["  ▘▘ ▝▝  ", "  ▘ ▘▝ ▝ ", "   ▘▘▝▝  ", "  ▝▘ ▝▘  ", " ▘ ▘ ▝ ▝ "]
BODY_COLORS = [203, 209, 215, 221, 227, 191, 155, 119, 85, 51, 45, 39, 75, 111, 147, 183, 219, 213, 207, 177,
               141, 105, 69, 167, 173, 179, 114, 80, 116, 182]
BADGES = {"work": ("♪", "♫"), "need": ("!", "‼"), "done": ("★", "☆")}
CLOSED_EYES = {"need": (">", "<"), "done": ("^", "^")}



def look(seed):
    """A stable Clawd for one tab: hat, eyes, legs and color come from a hash of the tab id."""
    n = int(hashlib.md5(seed.encode()).hexdigest(), 16)
    parts = []
    for options in (HATS, EYES, LEGS, BODY_COLORS):
        n, pick = divmod(n, len(options))
        parts.append(options[pick])
    return parts


QUADRANTS = " ▘▝▀▖▌▞▛▗▚▐▜▄▙▟█"


def face(left, right, gaze=0):
    """The face row; gaze -1/1 moves the eye holes one pixel left or right, "blink" fills them."""
    row = f" ▐{left}███{right}▌ "
    if not gaze:
        return row
    bits = [QUADRANTS.index(c) for c in row]
    px = [[bool(bits[c // 2] >> (r * 2 + c % 2) & 1) for c in range(18)] for r in range(2)]
    holes = [(r, c) for r in range(2) for c in range(4, 14) if not px[r][c]]
    for r, c in holes:
        px[r][c] = True
    if gaze != "blink":
        for r, c in holes:
            px[r][min(13, max(4, c + gaze))] = False
    return "".join(QUADRANTS[sum(px[r][c * 2 + d] << (r * 2 + d) for r in range(2) for d in range(2))] for c in range(9))


def creature(seed, state, frame, gaze=0):
    hat, (left, right), legs, _ = look(seed)
    if state == "done":
        fingers, palm, arm = WAVE[WAVE_PATH[frame % len(WAVE_PATH)]]
        return [hat[:8] + fingers, f" ▐{left}███{right}▌" + palm, "▝▜█████▛" + arm, legs]
    if state == "work":
        arms = "▗▟█████▙▖" if frame % 2 else "▝▜█████▛▘"
        return [hat, face(left, right, gaze), arms, LAPTOP]
    return [hat, face(left, right, gaze), "▝▜█████▛▘", legs]


WAVE = [("  ", "▛ ", "  "), ("  ", "▞▘", "  "), ("  ", "▄▀", "  ")]
WAVE_PATH = [0] * 5 + [1] * 3 + [2] * 5 + [1] * 3
LAPTOP = "▀▀▀▀▀▀▀▀▀▀▀"
LID = "▔▔▔▔▔▔"
CODE = ["</>", "{ }", "01 ", " ;"]
SPIN = "◜◝◞◟"
PETS_HELP = ["←→↑↓ move", "↵ open", "w whip", "f feed", "p pat", "b scene", "⇧↑↓ room", "⇧←→ fold", "v list view", "/ filter",
             "1-4 state", "s sort", "r rename", "n name", "- + dim", "click/2×click", "right-click whip", "middle-click pat", "q quit"]
LIST_HELP = ["↑↓ move", "↵ go/fold", "←→ fold", "/ filter", "v pets", "s sort", "⇧↑↓ group", "1-4 state", "r rename", "n name",
             "< > resize", "R refresh", "a untitled", "q quit"]
PET_W, PET_H = 26, 10
ART_W = 18
IDLE_FADE, HALO = 0.2, 0.55
BLANK = (" ", 0)


def wide(ch, cache={}):
    """Whether a character takes two cells."""
    if ch not in cache:
        cache[ch] = unicodedata.east_asian_width(ch) in ("W", "F")
    return cache[ch]
SPARK = [(0, 10, "╲│╱"), (1, 10, "─✸─"), (2, 10, "╱│╲")]
DUST = [(0, 8, "·   ·"), (2, 8, "·   ·"), (1, 7, "·")]
WHIP = ([[(0, 15, "╲"), (1, 16, "╲")]] * 4 + [[(0, 15, "│"), (1, 15, "│")]] * 3
        + [[(0, 14, "╱"), (1, 13, "╱")]] * 2 + [[(1, 11, "━━━━━╾")]] * 2
        + [[(1, 11, "✶━━━━╾")]] * 2 + [SPARK + [(1, 13, "━━━╾")]] * 4 + [DUST] * 5)
WHIP_HIT = 11
FOODS = "🍎🍐🍊🍋🍌🍉🍇🍓🫐🍒🍑🥭🍍🥥🥝🍅🥑🥕🌽🥐🥯🍞🥨🧀🥚🥞🧇🥓🍗🍖🌭🍔🍟🍕🥪🌮🌯🥗🍝🍜🍣🍤🥟🍩🍪🎂🧁🍫🍬🍦"
FEED = ([[(0, 15, "*")]] * 3 + [[(0, 14, "*")]] * 3 + [[(1, 14, "*")]] * 3 + [[(1, 13, "*")]] * 3
        + [[(1, 12, "*")]] * 8 + [[(1, 12, "*"), (2, 13, "·")]] * 4 + [[(2, 13, "·"), (3, 14, "·")]] * 4
        + [[(1, 14, "♥")]] * 6 + [[(0, 15, "♥")]] * 8)
PAT = [[(0, 6, "▄▄▄▄")] if i // 6 % 2 else [(-1, 6, "▄▄▄▄")] for i in range(24)] \
    + [[(0, 14, "♥")]] * 6 + [[(-1, 15, "♥"), (0, 13, "♥")]] * 8
SOUNDS = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "sounds")
SOUND = {"whip": "whip.mp3", "feed": "munch.mp3", "pat": "sparkle.mp3"}


# Idle Clawds play a sport. Each frame is drawn as pixels (two per cell side, two per cell height) and then packed
# into quadrant glyphs with at most two colors per cell.
COLS, ROWS, OX, OY = 16, 5, 4, 2          # canvas cells; body pixel (0, 0) sits at canvas pixel (OX, OY)


def decode(rows, key, out, top=0):
    """Glyph rows -> pixels {(x, y): key}, row r covering pixel rows top+2r and top+2r+1."""
    for r, line in enumerate(rows):
        for c, ch in enumerate(line):
            bits = QUADRANTS.find(ch)
            for b, (dx, dy) in enumerate(((0, 0), (1, 0), (0, 1), (1, 1))):
                if bits > 0 and bits >> b & 1:
                    out[(c * 2 + dx, top + r * 2 + dy)] = key
    return out


HAT_PIXELS = {"    ╻    ": [(9, 0), (9, 1)], "  ♛      ": [(4, 0), (6, 0), (8, 0)] + [(x, 1) for x in range(4, 9)],
              "    ✿    ": [(8, 0), (10, 0), (9, 1)], "  ▁▃▅▃▁  ": [(x, 0) for x in range(7, 11)] + [(x, 1) for x in range(4, 14)],
              "   ◢◣    ": [(7, 0), (8, 0)] + [(x, 1) for x in range(6, 10)], "  ╲   ╱  ": [(4, 0), (5, 1), (13, 0), (12, 1)],
              "    ◆    ": [(8, 0), (9, 0), (8, 1), (9, 1)]}


def sprite(hat, face, legs):
    """Clawd without arms: hat, head and torso in B, the lowest torso row and legs in D, a shine spot in L."""
    px = decode([hat if hat not in HAT_PIXELS else "", face], "B", {})
    px.update(dict.fromkeys(HAT_PIXELS.get(hat, []), "B"))
    for x in range(3, 15):
        px[(x, 4)] = "B"
        px[(x, 5)] = "D"
    decode([legs], "D", px, 6)
    for x in (6, 7):
        if px.get((x, 2)) == "B":
            px[(x, 2)] = "L"
    return px


def mirror(points):
    return [(17 - x, y) for x, y in points]


def encode(px):
    """Pixels -> canvas cells (char, fg, bg); a cell keeps its two most common colors."""
    cells = []
    for r in range(ROWS):
        row = []
        for c in range(COLS):
            quad = [px.get((c * 2 + dx - OX, r * 2 + dy - OY)) for dy in (0, 1) for dx in (0, 1)]
            keys = [k for k in quad if k]
            if not keys:
                row.append((" ", None, None))
                continue
            ranked = sorted(set(keys), key=lambda k: (-keys.count(k), k))
            fg = ranked[0]
            bg = ranked[1] if len(ranked) > 1 and all(quad) else None
            bits = sum(1 << i for i, k in enumerate(quad) if k and k != bg)
            row.append((QUADRANTS[bits], fg, bg))
        cells.append(row)
    return cells


ARM = {"down": [(15, 4), (16, 4)], "out": [(15, 4), (16, 4), (17, 4)], "up": [(15, 4), (16, 3), (16, 2), (16, 1)],
       "forward_up": [(15, 4), (16, 3), (17, 2)], "low": [(15, 4), (16, 5), (17, 5)], "reach_low": [(15, 4), (16, 5), (17, 6), (18, 6)],
       "high": [(15, 4), (16, 3), (17, 3), (18, 3)]}
FEET = [(4, 6), (6, 6), (11, 6), (13, 6)]


def pose(right="down", left="down", legs=None, dx=0, dy=0, hat=True):
    hat_row, face_row, legs_row = LOOKS[0]
    px = sprite(hat_row if hat else "         ", face_row, legs_row)
    if legs is not None:
        for p in FEET:
            px.pop(p, None)
        for p in legs:
            px[p] = "D"
    for p in ARM[right]:
        px[p] = "B"
    for p in mirror(ARM[left]):
        px[p] = "B"
    return {(x + dx, y + dy): k for (x, y), k in px.items()}


def line(points, key, px):
    for p in points:
        px[p] = key
    return px


def soccer(t):
    """Keepy-uppy: the right foot kicks the ball up, arms out for balance."""
    t %= 24
    height = [0, 1, 2, 3, 3, 3, 2, 1][min(7, t // 3)]
    kick = t < 4
    legs = [(4, 6), (6, 6), (11, 6), (14, 6), (15, 6)] if kick else None
    px = pose("out" if t // 6 % 2 else "forward_up", "forward_up" if t // 6 % 2 else "out", legs)
    return px, [(3 - height, 8, "⚽")]


def basketball(t):
    """Three dribbles with the right hand, then a jump shot into a hoop and the ball rolls back."""
    t %= 120
    hoop = {(21, 0): "R", (22, 0): "R", (23, 0): "R", (24, 0): "R", (21, 1): "W", (23, 1): "W", (22, 2): "W", (24, 2): "W"}
    for y in range(-2, 8):
        hoop[(26, y)] = "G"
    hoop[(25, 0)] = "G"
    if t < 54:
        low = t % 18 < 9
        px = pose("reach_low" if low else "high")
        return {**px, **hoop}, [(3 if low else 2, 9, "🏀")]
    s = t - 54
    if s < 8:
        return {**pose("up", "up", hat=False), **hoop}, [(-1 if s > 3 else 0, 6, "🏀")]
    if s < 30:
        f = (s - 8) / 22
        col = round(6 + f * 4)
        row = round(-1 - 1.5 * 4 * f * (1 - f))
        return {**pose("forward_up", "forward_up", dy=-2 if s < 18 else 0), **hoop}, [(max(-1, row), col, "🏀")]
    if s < 44:
        return {**pose(), **hoop, **({(20, -2): "S", (25, -2): "S"} if s < 36 else {})}, [(min(3, (s - 30) // 3), 10, "🏀")]
    return {**pose("low"), **hoop}, [(3, 10 - (s - 44) // 8, "🏀")]


def baseball(t):
    """The pitch comes in, the bat swings through it, the ball flies off with a spark."""
    t %= 72
    bat_up = {(16, 3): "B", (17, 2): "W", (17, 1): "W", (17, 0): "W", (18, -1): "W", (18, -2): "W"}
    if t < 30:
        ball = [(2, 13 - (t - 6) // 6, "⚾")] if t >= 6 else []
        return {**pose("forward_up"), **line([(17, 2), (17, 1), (17, 0), (18, -1), (18, -2)], "N", {})}, ball
    if t < 36:
        bat = line([(x, 4) for x in range(17, 24)], "N", {})
        return {**pose("out"), **bat, (25, 3): "S", (26, 2): "S", (25, 5): "S"}, [(2, 12, "⚾")]
    if t < 56:
        s = t - 36
        bat = line([(16, 3), (15, 2), (14, 1), (13, 0)], "N", {})
        return {**pose("forward_up"), **bat}, [(max(-1, 1 - s // 5), 12 + s // 4, "⚾")] if s < 16 else []
    return {**pose("forward_up"), **line([(17, 2), (17, 1), (17, 0), (18, -1), (18, -2)], "N", {})}, []


def tennis(t):
    """Forehand rally against a wall: the racket swings forward on every return."""
    t %= 36
    wall = {(26, y): "G" for y in range(-2, 8)}
    ring = lambda cx, cy: {(cx + a, cy + b): "W" for a in (-1, 0, 1) for b in (-1, 0, 1) if (a, b) != (0, 0)}
    swing = t < 6
    if swing:
        racket = {(17, 4): "N", (18, 4): "N", **ring(20, 4)}
        px = pose("out")
    else:
        racket = {(17, 2): "N", (18, 1): "N", **ring(19, -1)}
        px = pose("forward_up")
    out = t < 18
    col = 10 + round(1.5 * (t / 18 if out else (36 - t) / 18))
    row = 2 if 6 <= t < 30 else 1
    return {**px, **racket, **wall}, [(row, col, "🎾")]


def lifting(t):
    """Clean and press: bar from the floor, to the chest, over the head with a shake, and down."""
    t %= 90
    def bar(y, dx=0):
        px = {(x + dx, y): "G" for x in range(-3, 21)}
        for x in (-4, -3, 20, 21):
            for yy in (y - 1, y, y + 1):
                px[(x + dx, yy)] = "K"
        return px
    if t < 20:
        return {**pose("low", "low", dy=1), **bar(7)}, []
    if t < 32:
        return {**pose("out", "out"), **bar(4)}, []
    if t < 70:
        shake = 1 if 40 <= t < 60 and t % 4 < 2 else 0
        return {**pose("up", "up", hat=False), **bar(0, shake), **({(19, 2): "W"} if 50 <= t < 66 else {})}, []
    return {**pose("out", "out"), **bar(4)}, []


def jumprope(t):
    """The rope swings over the head, in front, under the feet while Clawd hops, and behind."""
    t %= 20
    ends = lambda dy: {(-1, 4 + dy): "W", (18, 4 + dy): "W"}
    if t < 5:
        rope = {(x, -2): "W" for x in range(3, 15)} | {(x, -1): "W" for x in (1, 2, 15, 16)} | {(0, 0): "W", (17, 0): "W", (-1, 1): "W", (18, 1): "W", (-1, 2): "W", (18, 2): "W", (-1, 3): "W", (18, 3): "W"}
        return {**pose("out", "out"), **rope}, []
    if t < 10:
        rope = {(x, 6): "W" for x in range(1, 17)} | {(0, 5): "W", (17, 5): "W"}
        return {**pose("out", "out", dy=-1), **rope, **ends(-1)}, []
    if t < 15:
        rope = {(x, 7): "W" for x in range(2, 16)} | {(0, 5): "W", (17, 5): "W", (1, 6): "W", (16, 6): "W"}
        return {**pose("out", "out", dy=-2), **rope, **ends(-2)}, []
    rope = {(-2, y): "W" for y in range(0, 4)} | {(19, y): "W" for y in range(0, 4)}
    return {**pose("out", "out"), **rope}, []


def hula(t):
    """A hoop spins round the waist; it swings to one side and back while Clawd sways the other way."""
    t %= 16
    sway = [0, 1, 0, -1][t // 4]
    shift = -2 * sway
    px = pose("up", "up", dx=sway)
    hoop = {(x + shift, 5): "P" for x in range(-1, 19)} | {(-2 + shift, 4): "P", (19 + shift, 4): "P"}
    return {**px, **hoop}, []


def yoyo(t):
    """The yo-yo drops to the floor on its string and the hand yanks it back up."""
    t %= 36
    depth = [0, 1, 2, 3, 3, 3, 2, 1, 0, 0, 0, 0][t // 3]
    yank = 24 <= t < 30
    px = pose("high" if yank else "forward_up")
    hand = (18, 3) if yank else (17, 2)
    string = {(hand[0], hand[1] + i): "W" for i in range(1, depth + 1)}
    yo = {(hand[0] + a, hand[1] + depth + 1 + b): "R" for a in (0, 1) for b in (0, 1)}
    return {**px, **string, **yo}, []


def sleeping(t):
    """Eyes shut, slow breaths that squash the head down a pixel, and z's drifting up."""
    t %= 90
    px = pose()
    for x in range(4, 14):
        for y in (2, 3):
            if (x, y) not in px and 3 <= x <= 14:
                px[(x, y)] = "B"
    for p in ((4, 3), (5, 3), (12, 3), (13, 3)):
        px[p] = "D"
    if 45 <= t < 85:
        px = {(x, y + (1 if y < 2 else 0)): k for (x, y), k in px.items() if y != 2}
    z = [(2, 9, "z", "Z"), (1, 10, "z", "Z"), (0, 11, "Z", "W")]
    return px, [z[i] for i in range(3) if t // 15 % 6 >= i + 1 and t // 15 % 6 < i + 4]


def gaming(t):
    """A handheld console held low: the screen flickers, the buttons flash with each press, and a win now and then."""
    t %= 96
    win = t >= 80
    px = pose("up" if win else "low", "up" if win else "low", dy=-1 if win and t < 88 else 0)
    console = {(x, y): "G" for x in range(6, 12) for y in range(4, 8)}
    for cell, x in enumerate((6, 8, 10)):
        lit = "W" if win and t // 3 % 2 else "E" if (cell + t // 6) % 3 else "W"
        console[(x, 4)] = console[(x + 1, 4)] = lit
    console[(7, 6)] = "R" if t // 4 % 2 else "K"
    console[(10, 6)] = "K" if t // 4 % 2 else "R"
    return {**px, **console}, [(0, 10, "✦", "S")] if win else []


def eyes(px, shift=0, shut=False):
    """Move the eye holes sideways, or shut them into a dark line."""
    holes = [(x, y) for x in range(4, 14) for y in (2, 3) if (x, y) not in px]
    for p in holes:
        px[p] = "B"
    if shut:
        for p in ((4, 3), (5, 3), (12, 3), (13, 3)):
            px[p] = "D"
    else:
        for x, y in holes:
            px.pop((min(13, max(4, x + shift)), y), None)
    return px


def reading(t):
    """An open book held low, pages in a V with a dark cover; the eyes scan each line and a page turns now and then."""
    t %= 120
    px = eyes(pose("low", "low"), [-1, 0, 1, 0][t // 12 % 4])
    art = ["NWWWWWWNWWWWWWN", "NWKWKWWNWWKWKWN", "NNNNNNNNNNNNNNN"]
    book = {(1 + x, 5 + y): c for y, row in enumerate(art) for x, c in enumerate(row)}
    if t >= 100:
        f = (t - 100) // 4
        arc = [(13, 4), (11, 3), (8, 3), (5, 3), (2, 4)][min(4, f)]
        book[arc] = "W"
        book[(arc[0] + 1, arc[1])] = "W"
    return {**px, **book}, []


def coffee(t):
    """A mug of coffee with steam curling up; every so often a slow, happy sip."""
    t %= 100
    sip = 70 <= t < 90
    if sip:
        px = eyes(pose("forward_up"), shut=True)
        mug = {(x, y): "W" for x in (15, 16, 17) for y in (2, 3)} | {(18, 2): "W", (18, 3): "W", (16, 1): "C", (15, 1): "C", (17, 1): "C"}
        return {**px, **mug}, []
    px = pose("out")
    mug = {(x, y): "W" for x in (18, 19, 20, 21) for y in (2, 3, 4, 5)} | {(22, 3): "W", (22, 4): "W"}
    for x in (18, 19, 20, 21):
        mug[(x, 2)] = "C"
    wisp = t // 6 % 2
    steam = {(19 + wisp, 1): "Z", (20 - wisp, 0): "Z", (19 + wisp, -1): "Z"}
    return {**px, **mug, **steam}, []


def guitar(t):
    """Strums a guitar held across the body; notes float up on every strum."""
    t %= 48
    strum = t // 6 % 2
    px = pose("low" if strum else "down", "out")
    body = {(x, y): "N" for x in range(4, 10) for y in range(4, 8)} | {(x, y): "R" for x in (6, 7) for y in (5, 6)}
    neck = {(10, 4): "K", (11, 4): "K", (12, 3): "K", (13, 3): "K", (14, 2): "K", (15, 2): "K", (16, 1): "K", (17, 1): "K", (18, 0): "N", (19, 0): "N"}
    notes = [(1 - t // 12 % 2, 9 + t // 12 % 3, "♪", "S")] + ([(0, 11 + t // 16 % 2, "♫", "P")] if t >= 24 else [])
    return {**px, **body, **neck}, notes


def fishing(t):
    """A rod out over the water: the bobber floats, dips on a bite, and a fish jumps out."""
    t %= 120
    rod = {(16 + i, 3 - (i + 1) // 2): "N" for i in range(10)}
    tip = (26, -2)
    water = {(x, 7): "A" for x in range(20, 28)}
    bite = 80 <= t < 96
    catch = 96 <= t < 120
    bob = 6 + (1 if bite and t // 3 % 2 else 0)
    line = {(26, y): "W" for y in range(-1, bob)}
    px = pose("forward_up", dy=-1 if catch and t < 104 else 0)
    if catch:
        f = (t - 96) / 24
        return {**px, **rod, **water}, [(round(3 - 6 * f * (1 - f)), round(11 - 4 * f), "🐟")]
    return {**px, **rod, **water, **line, (26, bob): "R", (27, bob): "R"}, []


def painting(t):
    """Paints at an easel: the brush dabs and the picture fills in stroke by stroke, then a fresh canvas."""
    t %= 120
    strokes = [((20, 0), "A"), ((21, 0), "A"), ((22, 0), "A"), ((23, 0), "A"), ((20, 1), "A"), ((21, 1), "A"),
               ((22, 1), "S"), ((23, 1), "S"), ((20, 2), "E"), ((21, 2), "E"), ((22, 2), "E"), ((23, 2), "E"),
               ((24, 0), "A"), ((25, 0), "A"), ((24, 1), "A"), ((25, 1), "A"), ((24, 2), "E"), ((25, 2), "E")]
    canvas = {(x, y): "W" for x in range(20, 26) for y in (-1, 0, 1, 2)}
    for p, color in strokes[:min(len(strokes), t // 6)]:
        canvas[p] = color
    easel = {(20, 3): "N", (25, 3): "N", (20, 4): "N", (25, 4): "N", (19, 5): "N", (26, 5): "N", (19, 6): "N", (26, 6): "N", (19, 7): "N", (26, 7): "N"}
    dab = t // 6 % 2
    px = pose("high" if dab else "forward_up")
    brush = {(19, 3 if dab else 1): "R"}
    return {**px, **canvas, **easel, **brush}, []


def meditating(t):
    """Cross-legged and floating, eyes shut, rising and settling slowly over a soft shadow."""
    t %= 80
    lift = [0, 1, 2, 2, 2, 1, 0, 0][t // 10]
    px = eyes(pose("out", "out", legs=[(x, 6) for x in range(4, 14)], dy=-lift), shut=True)
    shadow = {(x, 7): "K" for x in range(5 + lift, 13 - lift)}
    glow = [(0, -1, "·", "S"), (0, 10, "·", "S")] if 20 <= t < 50 else []
    return {**px, **shadow}, glow



LOOKS = [None]
SPORTS = {"soccer": soccer, "basketball": basketball, "baseball": baseball, "tennis": tennis, "lifting": lifting,
         "jumprope": jumprope, "hula": hula, "yoyo": yoyo, "sleeping": sleeping, "gaming": gaming, "reading": reading, "coffee": coffee,
          "guitar": guitar, "fishing": fishing, "painting": painting, "meditating": meditating}
SPORT_LENGTH = {"soccer": 24, "basketball": 120, "baseball": 72, "tennis": 36, "lifting": 90, "jumprope": 20, "hula": 16, "yoyo": 36, "sleeping": 90, "gaming": 96, "reading": 120, "coffee": 100,
                "guitar": 48, "fishing": 120, "painting": 120, "meditating": 80}
SPORT_COLORS = {"W": 254, "G": 245, "K": 239, "N": 137, "R": 202, "S": 221, "P": 212, "E": 113, "Z": 250, "A": 39, "C": 94}


def sport_frame(name, t, rows, cache={}):
    """Runs of (row, col, text, fg, bg) for one frame, plus its emoji; cached, since each sport loops."""
    key = name, t % SPORT_LENGTH[name], rows
    if key not in cache:
        LOOKS[0] = rows
        px, emoji = SPORTS[name](t)
        runs = []
        for r, row in enumerate(encode(px)):
            for c, (ch, fg, bg) in enumerate(row):
                if ch == " " and not bg:
                    continue
                if runs and runs[-1][0] == r and runs[-1][1] + len(runs[-1][2]) == c and runs[-1][3:] == (fg, bg):
                    runs[-1] = (r, runs[-1][1], runs[-1][2] + ch, fg, bg)
                else:
                    runs.append((r, c, ch, fg, bg))
        cache[key] = runs, emoji
    return cache[key]


# Scenes behind the Clawds: a color wash plus big silhouettes built from textured cells, like a live ASCII wallpaper.
RAMP = "ttSSX%;:"


def spot(i, w, h):
    """A stable pseudo-random cell and phase for element i."""
    n = int(hashlib.md5(str(i).encode()).hexdigest(), 16)
    return n % w, n // w % h, n % 997 / 997


def px(art):
    """Square-grid pixel art ('#' on) to cell rows: every pixel is two cells wide, so proportions hold in a terminal."""
    return [row.replace("#", "##").replace(".", "  ") for row in art]


def ellipse(w, h):
    """Square-grid pixel art of a filled ellipse w wide and h tall."""
    return ["".join("#" if ((x - (w - 1) / 2) / (w / 2)) ** 2 + ((y - (h - 1) / 2) / (h / 2)) ** 2 <= 1 else "." for x in range(w))
            for y in range(h)]


def overlay(size, *parts):
    """Pixel art of the given size with each (art, y, x) part stamped on it."""
    w, h = size
    grid = [["."] * w for _ in range(h)]
    for art, oy, ox in parts:
        for r, row in enumerate(art):
            for c, ch in enumerate(row):
                if ch == "#" and 0 <= r + oy < h and 0 <= c + ox < w:
                    grid[r + oy][c + ox] = "#"
    return ["".join(row) for row in grid]


def stroke(length, dx, dy, thick=2):
    """Pixel art of a diagonal stroke."""
    cells = {(x * dx + k, x * dy) for x in range(length) for k in range(thick)}
    x0 = min(x for x, _ in cells)
    cells = {(x - x0, y) for x, y in cells}
    w, h = max(x for x, _ in cells) + 1, max(y for _, y in cells) + 1
    return ["".join("#" if (x, y) in cells else "." for x in range(w)) for y in range(h)]


MOON = ["".join("." if ((x - 3) / 9) ** 2 + ((y - 10.5) / 9.5) ** 2 <= 1 else ch for x, ch in enumerate(row)) for y, row in enumerate(ellipse(18, 22))]
def cloud(seed, span, rows):
    """A lumpy cloud: round bumps of varied size along a flat base, with a ragged top edge."""
    n = int(hashlib.md5(f"cloud{seed}".encode()).hexdigest(), 16)
    parts, x = [], 1
    while x < span:
        n, r = divmod(n, max(1, rows // 2))
        d = 2 * r + 3
        parts.append((ellipse(d, d), rows - 2 - d, x))
        n, step = divmod(n, r + 3)
        x += r + 2 + step
    width = x + 3
    parts.append((ellipse(width - 4, 4), rows - 4, 2))
    art = overlay((width, rows), *parts)
    ragged = []
    for y, row in enumerate(art):
        line = ""
        for c, ch in enumerate(row):
            exposed = ch == "#" and (y == 0 or art[y - 1][c] == ".")
            n, drop = divmod(n, 5)
            line += "." if exposed and drop == 0 else ch
        ragged.append(line)
    return px(ragged)


CLOUDS = [cloud(k, span, rows) for k, (span, rows) in enumerate(((22, 8), (14, 6), (30, 9), (10, 5), (18, 7), (26, 8), (12, 5)))]
# a vertical gradient behind some scenes: the wash at the top, blended toward the second color at the bottom
SKY = {"clouds": ((170, 220, 250), (120, 185, 235)), "jellyfish": ((10, 20, 70), (5, 10, 40)), "moonlit": ((20, 28, 70), (10, 14, 40)),
       "pond": ((100, 160, 140), (70, 120, 110)), "lagoon": ((20, 150, 155), (10, 95, 105)), "boats": ((25, 140, 150), (15, 100, 115)),
       "fireflies": ((18, 30, 26), (8, 16, 12)), "claude": ((30, 24, 20), (16, 12, 10))}


def sky(name, y, h, cache={}):
    """The background color of row y in a scene with a gradient; the plain wash otherwise."""
    if name not in SKY:
        return WASH[name]
    key = name, y, h
    if key not in cache:
        top, bottom = SKY[name]
        f = y / max(1, h - 1)
        cache[key] = tuple(round(a + (b - a) * f) for a, b in zip(top, bottom))
    return cache[key]
KOI_BODY = ["...........#####............", ".........#########..........", ".......##############.......", ".....##################.....",
            "....#####################...", "....#######################.", "....#######################.", "....#####################...",
            ".....##################.....", ".......###########.####.....", ".........######....##.......", "...................#........"]
KOI_TAIL = ["#...", "##..", "###.", "###.", "###.", "###.", "##..", "#..."]
KOI = [px(overlay((28, 12), (KOI_BODY, 0, 0), (KOI_TAIL, 2 + wag, 0))) for wag in (-1, 0, 1, 0)]
KOI_EYE = (5, 46)
KOI_SPOTS = [(3, 24), (6, 34), (8, 20), (2, 30)]
TURTLE = px(overlay((34, 15), (ellipse(18, 11), 2, 8), (ellipse(6, 5), 5, 26), (ellipse(3, 3), 6, 31),
                    (stroke(7, 1, 1), 0, 1), (stroke(7, 1, 1), 0, 20), (stroke(7, -1, 1), 8, 1), (stroke(7, -1, 1), 8, 20)))
TURTLE_SHELL = px(ellipse(12, 7))
BELL = [px(ellipse(18, 12)[:6]), px(overlay((18, 6), (ellipse(16, 12)[:6], 0, 1)))]
BOAT = px(overlay((26, 10), (["....#....", "....#....", "...###...", "..#####..", ".#######.", "#########"], 0, 8),
                  (["##########################", ".########################.", "...####################...", ".....################....."], 6, 0)))
PAD = px([row[:5] + ("." if r >= 3 else row[5]) + row[6:] for r, row in enumerate(ellipse(10, 6))])
# background wash and the default text color on it, per scene
WASH = {"claude": 233, "clouds": 153, "lagoon": 30, "pond": 66, "jellyfish": 17, "boats": 30, "fireflies": 234, "moonlit": 17}
WASH_FG = {"clouds": 238, "pond": 254, "lagoon": 254, "boats": 254}


def blob(rows, oy, ox, fg, bg, t, salt=0, flip=False, edge=None, cache={}):
    """Runs of textured cells for a silhouette. Each '#' gets a glyph that changes now and then; edge cells get a darker bg.
    A fractional oy moves the shape by half a row: its top and bottom edges become half blocks."""
    q = int(t * 2) % 40
    shape = id(rows), salt, flip, edge is not None
    if shape not in cache:
        cache[shape] = runs = []
        width = max(len(r) for r in rows)
        grid = [r.ljust(width) for r in rows]
        if flip:
            grid = [r[::-1] for r in grid]
        on = lambda r, c: 0 <= r < len(grid) and 0 <= c < width and grid[r][c] == "#"
        kind = lambda r, c: (edge is not None and not (on(r - 1, c) and on(r + 1, c) and on(r, c - 1) and on(r, c + 1)),
                             not on(r - 1, c), not on(r + 1, c))
        for r, row in enumerate(grid):
            c = 0
            while c < width:
                if row[c] != "#":
                    c += 1
                    continue
                start = c
                here = kind(r, c)
                while c < width and row[c] == "#" and kind(r, c) == here:
                    c += 1
                runs.append((r, start, c, *here))
    half = oy - int(oy) >= 0.5
    oy = int(oy)
    out = []
    for r, start, c, rim, top, bottom in cache[shape]:
        key = salt, r, start, c, q, flip
        if key not in cache:
            cache[key] = "".join(RAMP[((h := (r * 31 + x * 17 + salt * 7) * 2654435761 >> 7 & 0xFFFF) + int(t * 0.5 + h % 97 / 97)) % len(RAMP)]
                                 for x in range(start, c))
        color = edge if rim else bg
        if half and top:
            out.append((oy + r, ox + start, "▄" * (c - start), color, None))
        else:
            out.append((oy + r, ox + start, cache[key], fg, color))
        if half and bottom:
            out.append((oy + r + 1, ox + start, "▀" * (c - start), color, None))
    return out


def bounce(t, speed, span, ph=0.0):
    """Position along a back-and-forth path of length span, and whether it moves left."""
    pos = (t * speed + ph * span) % (2 * span)
    return span - abs(pos - span), pos > span


def scene(name, t, w, h):
    """Runs of (y, x, text, fg, bg) for a background scene at time t, clipped to a w×h area."""
    out = []
    if name == "moonlit":
        for i in range(w * h // 55):
            x, y, ph = spot(i, w, h)
            tw = math.sin(t * 1.2 + ph * 40)
            out.append((y, x, "+" if tw > 0.9 else "·" if tw > -0.3 else " ", 189 if tw > 0.5 else 61, None))
        out += blob(px(MOON), 1, w - 44, 137, 223, t, 1, edge=180)
        for i, (speed, y) in enumerate(((1.0, 3), (0.7, h - 9), (1.3, h // 2 - 2), (0.9, h // 3))):
            x = int(t * speed + i * 50) % (w + 30) - 30
            out += blob(CLOUDS[i % 4], y, x, 17, 60, t, 10 + i, edge=59)
        shoot = t % 11
        if shoot < 0.9:
            out.append((1 + int(shoot * 4), int(w * 0.15 + shoot * 40), "━━+", 189, None))
    elif name == "claude":
        cx, cy = w - 44, 16
        for k in range(8):
            a = k * math.pi / 4
            long = 26 + 6 * math.sin(t * 1.6 + k * 1.3)
            for d in range(3, int(long) + 1):
                y, x = cy + round(math.sin(a) * d * 0.5), cx + round(math.cos(a) * d * 1.1)
                shade = (173, 209, 215, 223)[(k * 5 + d * 3 + int(t)) % 4]
                thick = 2 if k % 2 else 1
                for dy in range(-thick // 2, thick // 2 + 1):
                    out.append((y + dy, x - 1, RAMP[(k * 3 + d + dy + int(t * 1.5)) % 8] * 4, 52, shade))
        out += blob(px(ellipse(4, 3)), cy - 1, cx - 4, 52, 223, t, 5)
        for i in range(w * h // 300):
            x, y, ph = spot(300 + i, w, h)
            out.append((y, x, "()$>=<;"[i % 7], 94 if math.sin(t + ph * 30) > 0 else 58, None))
    elif name == "clouds":
        for i in range(9):
            _, y, ph = spot(i, w, max(1, h - 8))
            x = int(t * (0.8 + ph * 1.2) + ph * w) % (w + 64) - 64
            out += blob(CLOUDS[i % len(CLOUDS)], y, x, 250, 255, t, 20 + i)
        for i in range(4):
            _, y, ph = spot(70 + i, w, max(1, h // 2))
            x = int(t * 6 + ph * w) % (w + 4) - 2
            out.append((y, x, "v" if int(t * 3 + i) % 2 else "^", 240, None))
    elif name == "lagoon":
        for i in range(w * h // 70):
            x, y, ph = spot(i, w, h)
            out.append((y, int(x + t * 1.5 + ph * 5) % w, "·" if ph > 0.5 else "~", 37, None))
        x, flip = bounce(t, 2.0, w + 68)
        y = h // 2 - 8 + math.sin(t * 0.4) * 2
        out += blob(TURTLE, y, int(x) - 68, 58, 143, t, 30, flip, edge=101)
        out += blob(TURTLE_SHELL, y + 4, int(x) - 68 + 22, 52, 167, t, 31, edge=131)
        for i in range(5):
            _, fy, ph = spot(40 + i, w, h)
            fx = int(t * (6 + ph * 6) + ph * w) % (w + 3) - 1
            out.append((fy, fx, "<>" if i % 2 else "<·", 222, None))
    elif name == "pond":
        for i in range(6):
            x, y, ph = spot(50 + i, w - 14, h - 4)
            out += blob(PAD, y, x, 22, 71 if i % 2 else 65, t, 40 + i, edge=65 if i % 2 else 59)
        for i in range(w * h // 400):
            x, y, ph = spot(120 + i, w, h)
            ring = int(t * 1.2 + ph * 9) % 6
            if ring < 3:
                out.append((y, x - ring, "o" if ring == 0 else "( " + " " * (ring * 2 - 1) + ")", 73, None))
        for i in range(3):
            _, y, ph = spot(60 + i, w, max(1, h - 8))
            x, flip = bounce(t, 3.5 + ph * 1.5, w + 56, ph)
            dy = math.sin(t * 0.35 + ph * 7) * 2
            base = int(x) - 56
            width = len(KOI[0][0])
            frame = KOI[int(t * 4 + ph * 4) % 4]
            out += blob(frame, y + dy, base, 94 if i else 245, 180 if i else 255, t, 50 + i, flip, edge=173 if i else 252)
            dy = int(dy)
            for sy, sx in KOI_SPOTS + [KOI_EYE]:
                color = (52, 233) if (sy, sx) == KOI_EYE else (52, 211 if i else 209)
                out.append((y + dy + sy, base + (width - 2 - sx if flip else sx), "%%" if (sy, sx) != KOI_EYE else "##", *color))
    elif name == "jellyfish":
        for i in range(3):
            _, base, ph = spot(80 + i, w, max(1, h - 22))
            x = int(w * (i + 0.5) / 3 - 18 + 6 * math.sin(t * 0.2 + ph * 5))
            pulse = int(t * 1.6 + ph * 5) % 2
            y = base + 2 * math.sin(t * 0.5 + ph * 9)
            fg, bg = (53, 182) if i % 2 else (54, 189)
            out += blob(BELL[pulse], y, x, fg, bg, t, 60 + i, edge=175 if i % 2 else 146)
            y = int(y)
            for k in range(7):
                for d in range(1, 14 - (k % 2) * 4):
                    sway = round(2 * math.sin(t * 1.4 + d * 0.4 + k * 0.9 + ph * 3))
                    out.append((y + 6 + d - pulse, x + 4 + k * 4 + sway * 2, ":;t"[(d + k) % 3] * 2, fg, bg))
        for i in range(w * h // 70):
            x, y, ph = spot(200 + i, w, h)
            out.append((int(y - t * (0.8 + ph)) % h, x, "·", 25, None))
    elif name == "boats":
        for i in range(w * h // 40):
            x, y, ph = spot(i, w, h)
            out.append((y, int(x + t * 2 + ph * 5) % w, "· ·" if ph > 0.5 else "~", 44, None))
        for i in range(4):
            _, y, ph = spot(90 + i, w, max(1, h - 8))
            x = int(t * (1.2 + ph) + ph * w) % (w + 52) - 52
            out += blob(BOAT, y + math.sin(t * 1.3 + ph * 8) * 0.8, x, 30, 255 if i % 2 else 230, t, 70 + i, edge=252 if i % 2 else 187)
    elif name == "fireflies":
        for i in range(w * 3 // 2):
            x, _, ph = spot(100 + i, w, 1)
            row = h - 1 - int(ph * 3)
            out.append((row, x, "StX%t"[i % 5], 22 if ph > 0.5 else 28, None))
        for i in range(w * h // 500):
            cx, cy, ph = spot(i, w, h - 3)
            x = int(cx + 7 * math.sin(t * 0.25 + ph * 9)) % w
            y = int(cy + 2.5 * math.sin(t * 0.4 + ph * 13))
            glow = math.sin(t * 2.2 + ph * 20)
            if glow > 0:
                out += [(y - 1, x - 1, ": :", 58, None), (y + 1, x - 1, ": :", 58, None), (y, x - 2, "·", 58, None), (y, x + 2, "·", 58, None)]
            out.append((y, x, "t" if glow > 0.3 else "·", 22 if glow > 0.3 else 58, 227 if glow > 0.3 else None))
    clipped = []
    for y, x, text, fg, bg in out:
        if x < 0:
            text, x = text[-x:], 0
        if 0 <= y < h and x < w and text:
            clipped.append((y, x, text[: w - x], fg, bg))
    return clipped


SCENES = ["none", "claude", "clouds", "lagoon", "pond", "jellyfish", "boats", "fireflies", "moonlit"]


def tab_state():
    """Per tab, from Orca's own state database: its color, when it was last in front, and its Claude session id."""
    try:
        db = sqlite3.connect(f"file:{ORCA_STATE}?mode=ro", uri=True)
        row = db.execute("select payload from profile_state_documents where domain = 'workspaceSession'").fetchone()
        db.close()
    except sqlite3.Error:
        return {}
    tabs = {}
    for group in json.loads(row[0]).get("unifiedTabs", {}).values() if row else []:
        for tab in group:
            tabs[tab["id"]] = {"color": tab.get("color"), "focused": tab.get("lastFocusedAt") or 0,
                               "session_id": (tab.get("aiVaultTitle") or {}).get("sessionId")}
    return tabs


def xterm_rgb(index):
    """RGB of an xterm-256 cube color (16-231)."""
    levels = (0, 95, 135, 175, 215, 255)
    index -= 16
    return levels[index // 36], levels[index // 6 % 6], levels[index % 6]


FADE = 8


def dim(color, f, cache={}):
    """A color darkened by factor f."""
    if (color, f) not in cache:
        cache[color, f] = tuple(min(255, round(v * f)) for v in rgb(color))
    return cache[color, f]


def mix(color, other, f, cache={}):
    """A color moved a share f of the way toward another."""
    if (color, other, f) not in cache:
        cache[color, other, f] = tuple(round(a * (1 - f) + b * f) for a, b in zip(rgb(color), rgb(other)))
    return cache[color, other, f]


def tone(body, f):
    """A body color scaled by f: below 1 darker, above 1 lighter (toward white)."""
    return tuple(min(255, round(v * f + (255 - v) * max(0, f - 1))) for v in rgb(body))


# The dashboard paints its own cells in 24-bit color, so dimming and fades are exact; curses only reads keys.
A_BOLD, A_REVERSE, A_DIM, A_UNDERLINE = 1, 2, 4, 8
FG_SET, BG_SET = 1 << 32, 1 << 64
FG_MASK, BG_MASK = FG_SET | 0xFFFFFF << 8, BG_SET | 0xFFFFFF << 40
ANSI16 = [(0, 0, 0), (205, 0, 0), (0, 205, 0), (205, 205, 0), (0, 0, 238), (205, 0, 205), (0, 205, 205), (229, 229, 229),
          (127, 127, 127), (255, 0, 0), (0, 255, 0), (255, 255, 0), (92, 92, 255), (255, 0, 255), (0, 255, 255), (255, 255, 255)]
PAIRS = {1: 203, 2: 39, 3: 78, 4: 141, 5: 244, 6: 208, 7: (239, 236), 8: 237}
BG = None


def rgb(color):
    """RGB for an xterm-256 index, an (r, g, b) tuple or a #rrggbb string; None means the default."""
    if color is None or color == -1:
        return None
    if isinstance(color, tuple):
        return color
    if isinstance(color, str):
        return tuple(int(color[i:i + 2], 16) for i in (1, 3, 5))
    if color < 16:
        return ANSI16[color]
    if color >= 232:
        return (8 + (color - 232) * 10,) * 3
    return xterm_rgb(color)


def paint(fg=None, bg=None, flags=0):
    """A cell attribute: flags plus optional 24-bit foreground and background."""
    a = flags
    f, b = rgb(fg), rgb(bg)
    if f is not None:
        a |= FG_SET | (f[0] << 16 | f[1] << 8 | f[2]) << 8
    if b is not None:
        a |= BG_SET | (b[0] << 16 | b[1] << 8 | b[2]) << 40
    return a


def init_colors(bg):
    """Set the background every text attribute draws on (the panel behind the content, or the terminal default)."""
    global BG
    BG = bg
    pair.__defaults__[-1].clear()
    color_pair.__defaults__[-1].clear()
    cp.__defaults__[-1].clear()


def cp(n, cache={}):
    """One of the fixed color pairs: states, accents, the laptop."""
    if n not in cache:
        fg, bg = PAIRS[n] if isinstance(PAIRS[n], tuple) else (PAIRS[n], None)
        cache[n] = paint(fg, BG if bg is None else bg)
    return cache[n]


def pair(fg, bg=None, cache={}):
    """An attribute for an fg/bg pair of colors; bg None means the current background."""
    if (fg, bg) not in cache:
        cache[fg, bg] = paint(fg, BG if bg is None else bg)
    return cache[fg, bg]


def shaded(body, part="belly"):
    """Shading for one body color: belly (body over 20% darker), legs (darker) and shine (35% lighter over body)."""
    return pair(*{"belly": (body, tone(body, 0.8)), "legs": (tone(body, 0.8), None), "shine": (tone(body, 1.35), body)}[part])


def color_pair(hex_color, cache={}):
    """A #rrggbb foreground on the current background."""
    if hex_color not in cache:
        cache[hex_color] = paint(hex_color, BG)
    return cache[hex_color]


def last_assistant_time(path):
    with open(path, "rb") as f:
        f.seek(max(0, os.path.getsize(path) - 256_000))
        lines = f.read().decode("utf-8", "ignore").splitlines()
    for line in reversed(lines):
        if '"type":"assistant"' not in line:
            continue
        try:
            stamp = json.loads(line)["timestamp"]
        except (ValueError, KeyError):
            continue
        return datetime.fromisoformat(stamp.replace("Z", "+00:00")).timestamp() * 1000
    return 0


def ago(ms):
    if not ms:
        return ""
    s = max(0, time.time() - ms / 1000)
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if s >= size:
            return f"{int(s // size)}{unit}"
    return "now"


def short_branch(ref):
    return (ref or "").replace("refs/heads/", "")


def capped(items, prefix="", limit=5):
    """At most `limit` lines; a longer list shows limit - 1 and then "and N more"."""
    if len(items) <= limit:
        return [prefix + item for item in items]
    return [prefix + item for item in items[: limit - 1]] + [f"{' ' * len(prefix)}and {len(items) - limit + 1} more"]


def group_label(w, worktrees):
    """The project a worktree belongs to, then its own name when that adds something: "zenhr", "zenhr · on call"."""
    mains = {m["repoId"]: os.path.basename(m["path"]) for m in worktrees if m.get("isMainWorktree")}
    project = mains.get(w.get("repoId")) or os.path.basename(w["path"])
    name = w.get("displayName") or os.path.basename(w["path"])
    if name in (project, w.get("branch"), short_branch(w.get("branch")), os.path.basename(w["path"])):
        return project
    return f"{project} · {name}"


def preview_lines(t):
    lines = UNSAFE.sub("", t.get("screen") or t.get("preview") or "").splitlines()
    return [line for line in lines if not NOISE.search(line)]


class Dashboard:
    def __init__(self, screen):
        self.screen = screen
        self.sessions = []
        self.groups = {}
        self.query = ""
        self.state_filter = None
        self.show_untitled = False
        self.collapsed = set()
        self.cursor = 0
        self.message = ""
        self.help = False
        self.settings = {"split": 0.5, "sort": "state", "view": "list", **self.load_settings()}
        self.pet_pos = []
        self.drag_from = None
        self.acts = {}
        self.spin_until = 0
        self.scene = "none"
        self.transparent = False
        self.cells, self.prev, self.base, self.prev_base = [], [], 0, None
        self.fade_key, self.fade = None, []
        self.row_bg = []
        self.fill_key, self.fill = None, []
        self.last_state = {}
        self.hits = []
        self.lock = threading.Lock()
        self.screens = {}
        self.seen = {}
        self.transcripts = {}
        self.pid_handles = {}
        self.wake = threading.Event()
        self.pool = ThreadPoolExecutor(8)
        threading.Thread(target=self.refresh_forever, daemon=True).start()

    def refresh_forever(self):
        while True:
            try:
                self.refresh()
            except Exception as error:
                self.message = f"Refresh failed: {error}"
            self.wake.wait(3)
            self.wake.clear()

    def refresh(self):
        terminals = [t for t in orca("terminal", "list").get("result", {}).get("terminals", []) if t.get("handle") != SELF]
        worktrees = orca("worktree", "list").get("result", {}).get("worktrees", [])
        claude = self.claude_sessions()
        tabs = tab_state()

        stale = [t for t in terminals if t.get("title") and self.screens.get(t["handle"], (None,))[0] != t.get("lastOutputAt")]
        for t, screen in zip(stale, self.pool.map(lambda t: read_screen(t["handle"]), stale)):
            self.screens[t["handle"]] = (t.get("lastOutputAt"), screen)

        groups = {w["id"]: {"label": group_label(w, worktrees), "path": w["path"], "branch": short_branch(w.get("branch"))}
                  for w in worktrees}
        groups[FLOATING] = {"label": "Floating  ⌥⌘A", "path": "", "branch": ""}
        for t in terminals:
            t["title"] = t.get("title") or ""
            t["name"] = re.sub(r"^[⠀-⣿✳✻·⏺\s]+", "", UNSAFE.sub("", t["title"])).strip() or "(untitled)"
            t["screen"] = self.screens.get(t["handle"], (None, ""))[1]
            tab = tabs.get(t.get("tabId"), {})
            t["color"] = tab.get("color")
            session = claude.get(t["handle"], {})
            state = screen_state(t["screen"])
            t["state"] = "work" if state == "idle" and session.get("status") == "busy" else state
            finished = self.last_reply(tab.get("session_id") or session.get("sessionId"))
            looked = max(tab.get("focused", 0), self.seen.get(t.get("tabId"), 0))
            if t["state"] == "idle" and looked and finished > looked:
                t["state"] = "done"
            t["worktrees"] = self.worktrees_of(session, groups.get(t.get("worktreeId"), {}), worktrees)
            groups.setdefault(t.get("worktreeId"), {"label": os.path.basename(t.get("worktreePath") or "?"),
                                                    "path": t.get("worktreePath"), "branch": short_branch(t.get("branch"))})
        with self.lock:
            self.sessions, self.groups = self.merge_panes(terminals, claude), groups

    @staticmethod
    def merge_panes(terminals, claude):
        """One row per tab: a split tab's panes share its title, so show the agent pane and count the rest."""
        tabs = {}
        for t in terminals:
            tabs.setdefault(t.get("tabId") or t["handle"], []).append(t)
        rows = []
        for panes in tabs.values():
            main = max(panes, key=lambda t: (t["handle"] in claude, t.get("lastOutputAt") or 0))
            main["panes"] = len(panes)
            main["state"] = min((t["state"] for t in panes), key=STATE_ORDER.get)
            main["worktrees"] = list(dict.fromkeys(tree for t in panes for tree in t["worktrees"]))
            rows.append(main)
        return rows

    def mark_seen(self, tab_id):
        if tab_id:
            self.seen[tab_id] = time.time() * 1000

    def last_reply(self, session_id):
        """When Claude last replied in the session's transcript, in ms. Other entries (system, hooks) do not count."""
        if not session_id:
            return 0
        if session_id not in self.transcripts:
            found = glob.glob(os.path.expanduser(f"~/.claude/projects/*/{session_id}.jsonl"))
            self.transcripts[session_id] = [found[0] if found else None, None, 0]
        entry = self.transcripts[session_id]
        path, mtime, _ = entry
        try:
            current = os.path.getmtime(path) if path else None
        except OSError:
            return 0
        if current and current != mtime:
            entry[1], entry[2] = current, last_assistant_time(path)
        return entry[2]

    def claude_sessions(self):
        sessions = {}
        for path in glob.glob(REGISTRY):
            try:
                with open(path) as f:
                    session = json.load(f)
            except (OSError, ValueError):
                continue
            pid = session.get("pid")
            if pid not in self.pid_handles:
                self.pid_handles[pid] = terminal_of(pid)
            if self.pid_handles[pid]:
                sessions[self.pid_handles[pid]] = session
        return sessions

    @staticmethod
    def worktrees_of(session, group, worktrees):
        sid, cwd = session.get("sessionId"), session.get("cwd")
        own = [short_branch(w.get("branch")) or os.path.basename(w["path"]) for w in worktrees
               if sid and f"/{sid}/" in w["path"]]
        if cwd and group.get("path") and not cwd.startswith(group["path"]):
            own.append(cwd.replace(os.path.expanduser("~"), "~"))
        return own

    def items(self):
        """Selectable rows: group headers and the sessions under expanded groups."""
        q = self.query.lower()
        sessions = [t for t in self.sessions
                    if (self.show_untitled or t["title"])
                    and (not self.state_filter or t["state"] == self.state_filter)
                    and (not q or q in f"{t['name']} {' '.join(t['worktrees'])} {t['screen'][-2000:]}".lower())]
        by_group = {}
        for t in sessions:
            by_group.setdefault(t.get("worktreeId"), []).append(t)
        sort = SORTS[self.settings["sort"]]
        if self.settings["sort"] == "name":
            group_key = lambda g: self.groups.get(g, {}).get("label", "").lower()
        else:
            group_key = lambda g: min(sort(t) for t in by_group[g])
        order = sorted(by_group, key=lambda g: (g == FLOATING, group_key(g)))
        rows = []
        for gid in order:
            members = sorted(by_group[gid], key=sort)
            rows.append(("group", gid, members))
            if gid not in self.collapsed:
                rows += [("session", gid, t) for t in members]
        return rows

    def draw(self):
        s = self.screen
        self.scene = self.settings.get("scene", "none") if self.settings["view"] == "pets" else "none"
        wash = WASH.get(self.scene, -1)
        panel = dim(wash, self.light) if wash != -1 else None
        if panel != BG:
            init_colors(panel)
        self.base = paint(WASH_FG.get(self.scene), wash if wash != -1 else None)
        h, w = s.getmaxyx()
        self.row_bg = [sky(self.scene, max(0, y - 1), h - 2) for y in range(h)] if wash != -1 else [None] * h
        self.cells = [[BLANK] * w for _ in range(h)]
        self.hits = []
        self.fills(w, h)
        with self.lock:
            rows = self.items()
            counts = {key: sum(t["state"] == key for t in self.sessions if t["title"]) for key, _ in STATES}
        self.cursor = max(0, min(self.cursor, len(rows) - 1))

        left, right = self.margins(w)
        x = self.put(0, left + 1, " Sessions ", A_BOLD | A_REVERSE)
        for i, (key, label) in enumerate(STATES, 1):
            attr = cp(STATE_COLOR[key]) | (A_BOLD | A_UNDERLINE if self.state_filter == key else 0)
            x = self.put(0, x + 2, f"{STATE_GLYPH[key]} {counts[key]} {label}", attr | A_BOLD)
        x = self.put(0, x + 3, f"sort: {self.settings['sort']}", cp(4))
        self.put(0, x + 3, f"/ {self.query}" if self.query else "/ filter", cp(5))

        if self.settings["view"] == "pets":
            self.draw_pets(rows, h, w)
            footer = self.message or self.footer(PETS_HELP)
            self.put(h - 1, left + 1, footer[: right - left - 2], cp(5))
            self.flush()
            return

        split = w >= 80
        list_w = max(30, min(w - 20, int(w * self.split))) if split else w
        if split:
            for y in range(1, h - 1):
                self.put(y, list_w, "│")
        list_h = h - 2 if split else max(3, h - 10)
        heights = [2 if kind == "group" else 1 + len(t["worktrees"]) for kind, _, t in rows]
        top = 0
        while top < self.cursor and sum(heights[top:self.cursor + 1]) > list_h:
            top += 1
        y = 1
        for i in range(top, len(rows)):
            kind, gid, data = rows[i]
            if kind == "group" and i > top:
                y += 1
            if y + heights[i] - (kind == "group") > list_h + 1:
                break
            if kind == "group":
                self.group_row(y, gid, data, list_w, i == self.cursor)
                self.hits.append((y, y, 0, list_w, i))
                y += 1
            else:
                self.session_row(y, data, list_w, i == self.cursor)
                self.hits.append((y, y + heights[i] - 1, 0, list_w, i))
                y += heights[i]

        if rows:
            kind, gid, data = rows[self.cursor]
            box = (1, list_w + 2, h - 2, w - list_w - 3) if split else (list_h + 2, 1, h - list_h - 3, w - 2)
            if not split:
                self.put(list_h + 1, 0, "─" * w)
            if kind == "group":
                self.group_preview(*box, gid)
            else:
                self.session_preview(*box, data)
        else:
            self.put(2, 3, "No sessions match.", cp(5))

        footer = self.message or self.footer(LIST_HELP)
        self.put(h - 1, 1, footer[: w - 2], cp(5))
        self.flush()

    def draw_pets(self, rows, h, w):
        """Each Orca group is a room; each session is a creature that shows its state."""
        left, right = self.margins(w)
        cols = max(1, (right - left) // PET_W)
        left = (w - cols * PET_W) // 2
        placed, line, col, row_top = [], 0, cols, 0
        for kind, _, _ in rows:
            if kind == "group":
                line += 1 if placed else 0
                placed.append((line, 0, 1))
                line, col = line + 1, cols
                continue
            if col == cols:
                row_top, line, col = line, line + PET_H, 0
            placed.append((row_top, col, PET_H))
            col += 1
        self.pet_pos = [(top, col) for top, col, _ in placed]
        if not rows:
            self.put(2, 3, "No sessions match.", cp(5))
            return
        cur_top, _, cur_h = placed[self.cursor]
        view_h = h - 2
        self.pet_top = getattr(self, "pet_top", 0)
        if cur_top < self.pet_top:
            self.pet_top = cur_top
        elif cur_top + cur_h > self.pet_top + view_h:
            self.pet_top = cur_top + cur_h - view_h
        tick = int(time.time() * 30)
        headers = self.headers = {1 + top - self.pet_top for (kind, _, _), (top, _, _) in zip(rows, placed) if kind == "group"}
        wash = WASH[self.scene] if self.scene != "none" else None
        for sy, sx, text, fg, bg in scene(self.scene, time.time(), w, h - 2):
            if 1 + sy in headers:
                continue
            for x0, x1, f in self.zones(w, sx, sx + len(text)):
                self.put(1 + sy, x0, text[x0 - sx:x1 - sx], pair(dim(fg, f), dim(bg if bg is not None else sky(self.scene, sy, h - 2), f)))
        for i, ((kind, gid, data), (top, col, height)) in enumerate(zip(rows, placed)):
            y = 1 + top - self.pet_top
            if y < 1 or y + height > h - 1:
                continue
            if kind == "group":
                self.group_row(y, gid, data, left + cols * PET_W, i == self.cursor, left)
                self.hits.append((y, y, left, left + cols * PET_W, i))
            else:
                self.pet(y, left + col * PET_W, data, i == self.cursor, tick)
                self.hits.append((y, y + PET_H - 2, left + col * PET_W, left + (col + 1) * PET_W - 1, i))

    def pet(self, y, x, t, selected, tick):
        cell_x, x = x, x + (PET_W - ART_W) // 2
        frame = tick // 9 % 2
        seed = t.get("tabId") or t["handle"]
        body = color_pair("#%02x%02x%02x" % xterm_rgb(look(seed)[-1]))
        act, since = self.acts.get(seed, (None, 0))
        age = int((time.time() - since) * 30)
        whip = age if act == "whip" else 10**6
        state = t["state"]
        happy = act == "pat" and age < len(PAT) or act == "feed" and 12 <= age < len(FEED)
        flinch = WHIP_HIT <= whip < WHIP_HIT + 18
        wiggle = -(whip // 2 % 2) if flinch else 0
        phase = {"done": tick, "work": tick // 5}.get(state, frame)
        prev, self.last_state[seed] = self.last_state.get(seed), t["state"]
        if t["state"] == "done" and prev and prev != "done":
            self.acts[seed] = act, since = "jump", time.time()
            age = 0
        hop = -1 if act == "jump" and age < 24 and age // 6 % 2 == 0 else 0
        name_y, y = y, y + hop
        beat = (tick + int(hashlib.md5(seed.encode()).hexdigest(), 16)) % 180
        gaze = "blink" if beat < 4 or 100 <= beat < 104 else -1 if 40 <= beat < 70 else 1 if 130 <= beat < 160 else 0
        self.transparent = True
        playing = state == "idle" and (act is None or age > 150)
        if playing:
            self.play(y, x, seed, tick, gaze)
        for i, art in enumerate([] if playing else creature(seed, state, phase, gaze if state in ("work", "idle") else 0)):
            attr = cp(8) if state == "work" and i == 3 else body | A_BOLD
            if WHIP_HIT <= whip < WHIP_HIT + 2 and i < 3:
                attr |= A_REVERSE
            if state == "need" and frame and i == 2:
                attr |= A_REVERSE
            self.put(y + i, x + (3 if art == LAPTOP else 4) + wiggle, art, attr)
            if i == 1 and not attr & A_REVERSE and art[3] == "█":
                self.put(y + 1, x + 7 + wiggle, "▀", shaded(look(seed)[-1], "shine") | A_BOLD)
            elif i == 2 and not attr & A_REVERSE:
                self.put(y + 2, x + 6 + wiggle, "▀▀▀▀▀", shaded(look(seed)[-1]) | A_BOLD)
            elif i == 3 and art != LAPTOP:
                self.put(y + 3, x + 4 + wiggle, art, shaded(look(seed)[-1], "legs") | A_BOLD)
        if state == "work":
            self.put(y + 2, x + 5, LID, cp(7))
        if flinch:
            for offset, eye in zip((2, 6), (">", "<")):
                self.put(y + 1, x + 4 + wiggle + offset, eye, body | A_BOLD | A_REVERSE)
            self.put(y + (whip - WHIP_HIT) // 9, x + 3, "'", cp(STATE_COLOR["work"]) | A_BOLD)
        elif happy:
            for offset in (2, 6):
                self.put(y + 1, x + 4 + offset, "^", body | A_BOLD | A_REVERSE)
        elif state in CLOSED_EYES:
            for offset, eye in zip((2, 6), CLOSED_EYES[state]):
                self.put(y + 1, x + 4 + wiggle + offset, eye, body | A_BOLD | A_REVERSE)
        if state == "idle":
            pass
        elif state == "done":
            pass
        elif state == "work":
            self.put(y + 1 - tick // 18 % 2, x + 14, CODE[tick // 36 % len(CODE)], cp(STATE_COLOR["work"]) | A_DIM)
        else:
            badge_color = cp(STATE_COLOR[state]) | A_BOLD
            self.put(y + (0 if frame else 1), x + 14, BADGES[state][frame], badge_color)
        for dy, dx, lash in WHIP[whip] if whip < len(WHIP) else []:
            self.put(y + dy, x + dx, lash, cp(6 if (dy, dx, lash) in SPARK or "✶" in lash else 5) | (A_DIM if "·" in lash else A_BOLD))
        for treat, frames, look_of in (("feed", FEED, color_pair("#d7875f")), ("pat", PAT, color_pair("#ffd7af"))):
            for dy, dx, glyph in frames[age] if act == treat and age < len(frames) else []:
                glyph = FOODS[int(since * 1000) % len(FOODS)] if glyph == "*" else glyph
                self.put(y + dy, x + dx, glyph, (cp(1) if glyph == "♥" else look_of) | A_BOLD)
        if time.time() < self.spin_until:
            self.put(y, x + 1, SPIN[tick // 3 % len(SPIN)], cp(4) | A_BOLD)
        y = name_y
        if state != "idle":
            self.halo(y, x, look(seed)[-1], tick, int(hashlib.md5(seed.encode()).hexdigest(), 16) % 628 / 100)
        self.transparent = False
        tint = color_pair(t["color"]) if t["color"] else 0
        lines = textwrap.wrap(t["name"], PET_W - 2, max_lines=2, placeholder="…")
        for i, name in enumerate(lines):
            self.put(y + 4 + i, cell_x + max(0, (PET_W - 1 - len(name)) // 2), name, (A_REVERSE if selected else 0) | tint | A_BOLD)
        meta = ago(t.get("lastOutputAt")) + (f" ▥{t['panes']}" if t["panes"] > 1 else "")
        pet_name = self.pet_name(t)
        if pet_name:
            pet_name = pet_name[: PET_W - 4 - len(meta)]
            start = cell_x + max(0, (PET_W - 1 - len(pet_name) - 3 - len(meta)) // 2)
            start = self.put(y + 6, start, pet_name, body | A_BOLD)
            self.put(y + 6, start, f" · {meta}", cp(5))
        else:
            self.put(y + 6, cell_x + max(0, (PET_W - 1 - len(meta)) // 2), meta, cp(5))

    def play(self, y, x, seed, tick, gaze):
        hat, (left, right), legs, color = look(seed)
        n = int(hashlib.md5(seed.encode()).hexdigest(), 16)
        name = list(SPORTS)[n % len(SPORTS)]
        runs, emoji = sport_frame(name, tick + n, (hat, face(left, right, gaze), legs))
        colors = {"B": color, "D": tone(color, 0.8), "L": tone(color, 1.35), None: None, **SPORT_COLORS}
        colors = {k: None if v is None else mix(v, self.panel(y), IDLE_FADE) for k, v in colors.items()}
        for r, c, text, fg, bg in runs:
            sy, sx = y - 1 + r, x + 2 + c
            if r == 0 and self.cells[sy][1][0] != " ":
                continue
            self.put(sy, sx, text, pair(colors[fg], colors[bg]) | A_BOLD)
        for r, c, glyph, *key in emoji:
            if r >= 0:
                self.put(y + r, x + 4 + c, glyph, pair(colors[key[0]]) | A_BOLD if key else 0)

    def halo(self, y, x, body, tick, phase):
        """A soft glow in the body color behind a Clawd that needs attention, is ready or works: brightest at its middle,
        fading to the edges, with a slow breath. Drawn after it, under its cells."""
        pulse = HALO * (0.85 + 0.15 * math.sin(tick / 15 + phase))
        cx, cy = x + ART_W / 2 - 1, y + 1.5
        for yy in range(y - 2, y + 5):
            if yy < 1 or yy in self.headers:
                continue
            panel = self.panel(yy)
            under = paint(None, panel) if self.row_bg[yy] is not None else 0
            row = self.cells[yy]
            for xx in range(max(0, x - 4), min(len(row), x + ART_W + 3)):
                ch, a = row[xx]
                d = ((xx - cx) / 12) ** 2 + ((yy - cy) / 3.6) ** 2
                if ch and d < 1 and a & BG_MASK in (0, under):
                    row[xx] = (ch, a & ~BG_MASK | paint(None, mix(panel, body, round(pulse * (1 - d), 2))))

    def panel(self, y):
        """The color of the panel behind the content on one row."""
        return dim(self.row_bg[y], self.light) if self.row_bg[y] is not None else (0, 0, 0)

    def pet_move(self, key):
        if not self.pet_pos:
            return
        top, col = self.pet_pos[self.cursor]
        if key in (curses.KEY_LEFT, "h"):
            self.cursor -= 1
        elif key in (curses.KEY_RIGHT, "l"):
            self.cursor += 1
        else:
            down = key in (curses.KEY_DOWN, "j")
            lines = sorted({p[0] for p in self.pet_pos if (p[0] > top if down else p[0] < top)}, reverse=not down)
            if lines:
                options = [i for i, p in enumerate(self.pet_pos) if p[0] == lines[0]]
                self.cursor = min(options, key=lambda i: abs(self.pet_pos[i][1] - col))
        self.cursor = max(0, min(self.cursor, len(self.pet_pos) - 1))

    @property
    def light(self):
        """How bright the panel behind the content is, 1 = no dimming; the 'dim' setting is the darkening share."""
        return round(1 - max(0.0, min(0.9, self.settings.get("dim", 0.25))), 2)

    def zones(self, w, x0, x1):
        """Split the span x0..x1 into (start, end, dim factor) pieces: full light outside, the panel inside, a fade between."""
        left, right = self.margins(w)
        light = self.light
        key = w, left, light
        if self.fade_key != key:
            self.fade_key = key
            edges = [(0, 1.0)]
            for k in range(FADE, 0, -1):
                edges.append((left - k, round(light + (1 - light) * k / (FADE + 1), 2)))
            edges.append((left, light))
            for k in range(FADE):
                edges.append((right + k, round(light + (1 - light) * (k + 1) / (FADE + 1), 2)))
            edges.append((right + FADE, 1.0))
            self.fade = [(x, f) for x, f in edges if x >= 0]
        pieces = []
        starts = [x for x, _ in self.fade]
        i = max(0, bisect.bisect_right(starts, x0) - 1)
        while i < len(self.fade) and self.fade[i][0] < x1:
            a = max(x0, self.fade[i][0])
            b = min(x1, self.fade[i + 1][0]) if i + 1 < len(self.fade) else x1
            if a < b:
                pieces.append((a, b, self.fade[i][1]))
            i += 1
        return pieces

    def fills(self, w, h):
        """Per row, the background attribute of every column: the sky gradient, darker behind the content, with a fade.
        Built once per size, scene and dim; blank cells take it at flush time."""
        key = w, h, self.scene, self.light
        if self.fill_key == key:
            return
        self.fill_key = key
        self.fill = []
        for y in range(h):
            row = []
            for x0, x1, f in self.zones(w, 0, w):
                row += [paint(None, dim(self.row_bg[y], f)) if self.row_bg[y] is not None else 0] * (x1 - x0)
            self.fill.append(row)

    def margins(self, w):
        """Left and right edges of the content: the pets view keeps a margin of a fifth of the width on each side."""
        margin = max(2, w // 5) if self.settings["view"] == "pets" else 0
        return margin, w - margin

    def group_row(self, y, gid, members, width, selected, x0=0):
        base = A_REVERSE if selected else 0
        if selected:
            self.put(y, x0, " " * (width - x0 - 1), base)
        group = self.groups.get(gid, {})
        x = self.put(y, x0 + 1, ("▸ " if gid in self.collapsed else "▾ ") + group.get("label", gid), base | A_BOLD | cp(4))
        if group.get("branch") and group["branch"] != group.get("label"):
            self.put(y, x + 2, group["branch"][: max(0, width - x - 12)], base | cp(5))
        busy = [t for t in members if t["state"] != "idle"]
        tail = str(len(members))
        self.put(y, width - len(tail) - 2, tail, base | cp(5))
        for i, t in enumerate(busy):
            self.put(y, width - len(tail) - 3 - len(busy) + i, STATE_GLYPH[t["state"]], base | cp(STATE_COLOR[t["state"]]) | A_BOLD)

    def session_row(self, y, t, width, selected):
        base = A_REVERSE if selected else 0
        if selected:
            self.put(y, 0, " " * (width - 1), base)
        if t["color"]:
            self.put(y, 1, "▌", color_pair(t["color"]))
        self.put(y, 3, STATE_GLYPH[t["state"]], cp(STATE_COLOR[t["state"]]) | base | A_BOLD)
        age = ago(t.get("lastOutputAt"))
        if t["panes"] > 1:
            age = f"▥{t['panes']}  {age}"
        name = t["name"][: max(1, width - 10 - len(age))]
        ticket = TICKET.search(name)
        x = 5
        if ticket:
            x = self.put(y, x, name[: ticket.start()], base)
            x = self.put(y, x, ticket.group(), base | A_BOLD | cp(4))
            self.put(y, x, name[ticket.end():], base)
        else:
            self.put(y, x, name, base)
        self.put(y, width - len(age) - 2, age, base | cp(5))
        for i, line in enumerate(capped(t["worktrees"], "└ "), 1):
            self.put(y + i, 7, line[: width - 9], cp(5))

    def group_preview(self, y, x, height, width, gid):
        group = self.groups.get(gid, {})
        self.put(y, x, group.get("label", gid)[:width], A_BOLD)
        self.put(y + 1, x, (group.get("path") or "Floating terminals")[:width], cp(5))
        members = [t for t in self.sessions if t.get("worktreeId") == gid and (self.show_untitled or t["title"])]
        for i, (key, label) in enumerate(STATES):
            self.put(y + 3 + i, x, f"● {sum(t['state'] == key for t in members)} {label}", cp(STATE_COLOR[key]))

    def session_preview(self, y, x, height, width, t):
        self.put(y, x, t["name"][:width], A_BOLD)
        group = self.groups.get(t.get("worktreeId"), {}).get("label", "")
        rows = [("State", dict(STATES)[t["state"]], cp(STATE_COLOR[t["state"]]) | A_BOLD), ("Group", group, 0),
                ("Clawd", self.pet_name(t), 0), ("Last output", f"{ago(t.get('lastOutputAt'))} ago", 0)]
        rows += [("Worktrees" if i == 0 else "", line, cp(4)) for i, line in enumerate(capped(t["worktrees"]))]
        line = y + 2
        for label, value, attr in rows:
            if not value:
                continue
            if label:
                self.put(line, x, f"{label}:", cp(5))
            self.put(line, x + 16, value[: width - 16], attr)
            line += 1
        top = line + 1
        lines = []
        for text in preview_lines(t):
            lines += [text[i:i + width] for i in range(0, max(len(text), 1), width)]
        for i, text in enumerate(lines[-max(1, height - (top - y)):]):
            self.put(top + i, x, text)

    def put(self, y, x, text, attr=0):
        h, w = self.screen.getmaxyx()
        if 0 <= y < h and x < w:
            if BG is not None and not attr & BG_SET:
                attr |= paint(None, dim(self.row_bg[y], self.light))
            row = self.cells[y]
            pieces = [(x, text)] if self.scene == "none" or not self.transparent else \
                [(x + m.start(), m.group()) for m in re.finditer(r"\S+", text)]
            for px, piece in pieces:
                if piece.isascii() and 0 <= px:
                    piece = piece[: max(0, w - px)]
                    if px and row[px - 1][0] and wide(row[px - 1][0]):
                        row[px - 1] = (" ", row[px - 1][1])
                    row[px:px + len(piece)] = [(ch, attr) for ch in piece]
                    continue
                for ch in piece:
                    if px >= w:
                        break
                    if px >= 0:
                        if px and row[px - 1][0] and wide(row[px - 1][0]):
                            row[px - 1] = (" ", row[px - 1][1])
                        row[px] = (ch, attr)
                        if wide(ch) and px + 1 < w:
                            px += 1
                            row[px] = ("", attr)
                    px += 1
        return x + len(text)

    def sgr(self, a, cache={}):
        """The escape sequence that sets a cell attribute."""
        if a not in cache:
            parts = ["0"] + [code for bit, code in ((A_BOLD, "1"), (A_DIM, "2"), (A_UNDERLINE, "4"), (A_REVERSE, "7")) if a & bit]
            for flag, shift, code in ((FG_SET, 8, 38), (BG_SET, 40, 48)):
                if a & flag:
                    v = a >> shift & 0xFFFFFF
                    parts.append(f"{code};2;{v >> 16};{v >> 8 & 255};{v & 255}")
            cache[a] = "\033[" + ";".join(parts) + "m"
        return cache[a]

    def flush(self):
        """Send the rows that changed since the last frame to the terminal."""
        w = len(self.cells[0]) if self.cells else 0
        out = []
        base = self.base, self.fill_key
        if len(self.prev) != len(self.cells) or (self.prev and len(self.prev[0]) != w) or self.prev_base != base:
            out.append("\033[2J")
            self.prev = []
        base_fg = self.base & FG_MASK
        for y, row in enumerate(self.cells):
            if y < len(self.prev) and row == self.prev[y]:
                continue
            out.append(f"\033[{y + 1};1H")
            last, after_wide = None, False
            fill = self.fill[y]
            for x, (ch, a) in enumerate(row[: w - 1]):
                if not ch:
                    if not after_wide:
                        out.append(" ")
                    after_wide = False
                    continue
                eff = a | (0 if a & FG_SET else base_fg) | (0 if a & BG_SET else fill[x])
                if eff != last:
                    out.append(self.sgr(eff))
                    last = eff
                out.append(ch)
                after_wide = wide(ch)
        self.prev, self.prev_base = self.cells, base
        if out:
            sys.stdout.write("".join(out) + "\033[0m")
            sys.stdout.flush()

    def read_key(self):
        """A key, None on timeout, or ("mouse", button, x, y, pressed) for an SGR mouse report."""
        try:
            key = self.screen.get_wch()
        except curses.error:
            return None
        if key == "\x1b":
            key = self.read_escape()
        if DEBUG:
            with open(DEBUG, "a") as log:
                log.write(f"{time.time():.2f} {key!r}\n")
        return key

    def read_escape(self):
        self.screen.nodelay(True)
        sequence = ""
        try:
            while len(sequence) < 24:
                try:
                    char = self.screen.get_wch()
                except curses.error:
                    break
                sequence += char if isinstance(char, str) else ""
                if char in ("M", "m") and sequence.startswith("[<"):
                    break
        finally:
            self.screen.timeout(self.frame_ms())
        if not sequence:
            return "\x1b"
        match = re.fullmatch(r"\[<(\d+);(\d+);(\d+)([Mm])", sequence)
        if not match:
            return None
        button, x, y, kind = match.groups()
        return ("mouse", int(button), int(x) - 1, int(y) - 1, kind == "M")

    def footer(self, hints):
        """The short hint line, or every hint after ?."""
        return "  ".join(hints if self.help else hints[:6] + ["? help", "q quit"])

    def frame_ms(self):
        return 16 if self.settings["view"] == "pets" else 1000

    def ask(self, prompt, initial=""):
        h, w = self.screen.getmaxyx()
        text = initial
        while True:
            self.put(h - 1, 0, " " * (w - 1))
            end = self.put(h - 1, 1, f"{prompt}{text}", A_BOLD)
            self.flush()
            sys.stdout.write(f"\033[{h};{end + 1}H\033[?25h")
            sys.stdout.flush()
            key = self.read_key()
            if key in ("\n", "\r", curses.KEY_ENTER):
                sys.stdout.write("\033[?25l")
                return text.strip()
            if key == "\x1b":
                curses.curs_set(0)
                return None
            if key in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                text = text[:-1]
            elif isinstance(key, str) and key.isprintable():
                text += key

    def filter_mode(self):
        while True:
            self.draw()
            key = self.read_key()
            if key == "\x1b":
                self.query = ""
                return
            if key in ("\n", "\r", curses.KEY_ENTER):
                return
            if key in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                self.query = self.query[:-1]
            elif key in (curses.KEY_UP, curses.KEY_DOWN):
                self.cursor += 1 if key == curses.KEY_DOWN else -1
            elif isinstance(key, str) and key.isprintable():
                self.query += key
                self.cursor = 0

    @staticmethod
    def load_settings():
        try:
            with open(SETTINGS) as f:
                return json.load(f)
        except (OSError, ValueError):
            return {}

    def save(self, **changes):
        self.settings.update(changes)
        try:
            with open(SETTINGS, "w") as f:
                json.dump(self.settings, f)
        except OSError:
            pass

    @property
    def split(self):
        return self.settings["split"]

    def resize(self, ratio):
        self.save(split=round(max(0.2, min(0.85, ratio)), 3))

    def pet_name(self, t):
        return self.settings.setdefault("pets", {}).get(t.get("tabId") or t["handle"], "")

    def mouse(self, button, x, y, pressed):
        """Click selects, a second click on the same row opens it, the wheel moves, and the divider drags."""
        width = self.screen.getmaxyx()[1]
        divider = max(30, min(width - 20, int(width * self.split)))
        if button == 64:
            self.pet_move(curses.KEY_UP) if self.settings["view"] == "pets" else setattr(self, "cursor", self.cursor - 1)
        elif button == 65:
            self.pet_move(curses.KEY_DOWN) if self.settings["view"] == "pets" else setattr(self, "cursor", self.cursor + 1)
        elif button == 2 and not pressed and self.settings["view"] == "pets":
            self.click(y, x)
            kind, _, data = self.items()[self.cursor]
            if kind == "session":
                self.act(data, "whip")
        elif button == 1 and not pressed and self.settings["view"] == "pets":
            self.click(y, x)
            kind, _, data = self.items()[self.cursor]
            if kind == "session":
                self.act(data, "pat")
        elif button == 0 and pressed:
            self.drag_from = x
        elif button == 0:
            on_divider = self.settings["view"] == "list" and self.drag_from is not None and abs(self.drag_from - divider) <= 1
            if on_divider and abs(x - divider) > 1:
                self.resize(x / width)
            elif not on_divider:
                self.click(y, x)
            self.drag_from = None

    def act(self, t, kind):
        self.acts[t.get("tabId") or t["handle"]] = (kind, time.time())
        sound = os.path.join(SOUNDS, SOUND.get(kind, ""))
        if os.path.isfile(sound):
            subprocess.Popen(["afplay", sound], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def click(self, y, x):
        hit = next((i for top, bottom, left, right, i in self.hits if top <= y <= bottom and left <= x <= right), None)
        if hit is None:
            return
        now = time.time()
        again = hit == self.cursor and now - getattr(self, "last_click", 0) < 0.5
        self.cursor, self.last_click = hit, now
        if again or self.items()[hit][0] == "group":
            self.open(*self.items()[hit])

    def open(self, kind, gid, data):
        if kind == "group":
            self.fold(gid, gid not in self.collapsed)
            return
        ok = orca("terminal", "switch", "--terminal", data["handle"]).get("ok")
        self.mark_seen(data.get("tabId"))
        self.message = f"→ {data['name']}" if ok else "Could not switch to that session."

    def fold(self, gid, collapse):
        (self.collapsed.add if collapse else self.collapsed.discard)(gid)
        self.cursor = next(i for i, row in enumerate(self.items()) if row[0] == "group" and row[1] == gid)

    def run(self):
        while True:
            self.draw()
            key = self.read_key()
            if key is None:
                continue
            self.message = ""
            rows = self.items()
            kind, gid, data = rows[self.cursor] if rows else (None, None, None)
            if key in ("q", "\x1b"):
                return
            elif key == "?":
                self.help = not self.help
            elif key == "v":
                self.save(view="list" if self.settings["view"] == "pets" else "pets")
                self.screen.timeout(self.frame_ms())
            elif key in (curses.KEY_SF, curses.KEY_SR, "J", "K"):
                headers = [i for i, row in enumerate(rows) if row[0] == "group"]
                if key in (curses.KEY_SF, "J"):
                    self.cursor = next((i for i in headers if i > self.cursor), self.cursor)
                else:
                    self.cursor = next((i for i in reversed(headers) if i < self.cursor), self.cursor)
            elif key in (curses.KEY_SLEFT, curses.KEY_SRIGHT, "H", "L") and gid:
                self.fold(gid, key in (curses.KEY_SLEFT, "H"))
            elif self.settings["view"] == "pets" and kind == "group" and key in (curses.KEY_LEFT, "h") \
                    and gid not in self.collapsed:
                self.fold(gid, True)
            elif self.settings["view"] == "pets" and kind == "group" and key in (curses.KEY_RIGHT, "l") \
                    and gid in self.collapsed:
                self.fold(gid, False)
            elif self.settings["view"] == "pets" and key in (curses.KEY_LEFT, curses.KEY_RIGHT, curses.KEY_UP,
                                                             curses.KEY_DOWN, "h", "j", "k", "l"):
                self.pet_move(key)
            elif key in (curses.KEY_DOWN, "j"):
                self.cursor += 1
            elif key in (curses.KEY_UP, "k"):
                self.cursor -= 1
            elif key in (curses.KEY_NPAGE, curses.KEY_PPAGE):
                self.cursor += 10 if key == curses.KEY_NPAGE else -10
            elif key in ("g", curses.KEY_HOME):
                self.cursor = 0
            elif key in ("G", curses.KEY_END):
                self.cursor = len(rows) - 1
            elif key in (curses.KEY_LEFT, "h") and gid:
                self.fold(gid, True)
            elif key in (curses.KEY_RIGHT, "l") and gid:
                self.fold(gid, False)
            elif key == "/":
                self.filter_mode()
            elif key in ("1", "2", "3", "4"):
                state = STATES[int(key) - 1][0]
                self.state_filter = None if self.state_filter == state else state
                self.cursor = 0
            elif key in ("<", ">", "[", "]"):
                self.resize(self.split + (0.05 if key in (">", "]") else -0.05))
            elif key == "s":
                names = list(SORTS)
                self.save(sort=names[(names.index(self.settings["sort"]) + 1) % len(names)])
                self.cursor = 0
            elif isinstance(key, tuple):
                self.mouse(*key[1:])
            elif key == "a":
                self.show_untitled = not self.show_untitled
            elif key in ("R", "\x12", curses.KEY_F5):
                self.screens.clear()
                self.pid_handles.clear()
                self.wake.set()
                self.message = "Refreshing…"
                self.spin_until = time.time() + 1.2
            elif key in ("\n", "\r", curses.KEY_ENTER) or (key == " " and kind == "group"):
                if kind:
                    self.open(kind, gid, data)
            elif key == "n" and kind == "session":
                name = self.ask("Name this Clawd: ", self.pet_name(data))
                if name is not None:
                    pets = self.settings.setdefault("pets", {})
                    pets[data.get("tabId") or data["handle"]] = name
                    if not name:
                        del pets[data.get("tabId") or data["handle"]]
                    self.save()
                    self.message = f"Hi, {name}!" if name else "Name removed."
            elif key in ("-", "=", "+") and self.settings["view"] == "pets":
                step = -0.05 if key == "-" else 0.05
                self.save(dim=round(max(0.0, min(0.9, self.settings.get("dim", 0.25) + step)), 2))
                self.message = f"Dim: {round(self.settings['dim'] * 100)}%"
            elif key == "b" and self.settings["view"] == "pets":
                current = self.settings.get("scene", "none")
                scenes = SCENES[(SCENES.index(current) if current in SCENES else 0) + 1:] + SCENES
                self.settings["scene"] = scenes[0]
                self.save()
                self.message = f"Scene: {scenes[0]}"
            elif key in ("w", "f", "p") and kind == "session" and self.settings["view"] == "pets":
                self.act(data, {"w": "whip", "f": "feed", "p": "pat"}[key])
            elif key == "r" and kind == "session":
                title = self.ask("Rename: ", data["name"])
                if title:
                    ok = orca("terminal", "rename", "--terminal", data["handle"], "--title", title).get("ok")
                    self.message = "Renamed." if ok else "Rename failed."
                    self.wake.set()


def main(screen):
    curses.curs_set(0)
    screen.refresh()
    init_colors(None)
    curses.set_escdelay(25)
    dashboard = Dashboard(screen)
    screen.timeout(dashboard.frame_ms())
    print("\033[?1000h\033[?1006h\033[?25l\033[2J", end="", flush=True)
    try:
        dashboard.run()
    finally:
        print("\033[?1006l\033[?1000l\033[0m\033[?25h", end="", flush=True)


if __name__ == "__main__":
    curses.wrapper(main)
